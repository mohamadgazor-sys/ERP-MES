# Real business / customer documents and exports (never commit).
# Documents and spreadsheets are ignored everywhere by extension, as a safety net.
# The ONLY exception is synthetic test fixtures under tests/fixtures/ (see
# tests/fixtures/README.md). Fixtures must contain invented data only.
# Do not create a directory named data/ or imports/ inside tests/fixtures/;
# those names are ignored at any depth by the rules in this file.
*.pdf
*.xlsx
*.xls
*.xlsm
*.csv
customer-data/
real-data/
imports/

# Approved synthetic test fixtures (must stay below all rules above)
!tests/fixtures/
!tests/fixtures/**/*.pdf
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.xls
!tests/fixtures/**/*.xlsm
!tests/fixtures/**/*.csv

# Local Claude Code settings
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db

# Demonstration credentials (one-time passwords of the fictional accounts) must never be committed; the files are written outside the repository.
*.credentials.txt
erpmes-demo-credentials*
