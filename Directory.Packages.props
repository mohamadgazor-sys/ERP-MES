<Project>

  <!-- Central package version management (Decision Log #44).
       A package is listed here only after it appears in the package table in docs/MILESTONE_1_PLAN.md
       section 8 with its dependency graph and vulnerability results (Decision Log #43, #53). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Test framework: xUnit v3 with the VSTest runner combination from the official template 4.0.2 (Decision Log #52). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
  </ItemGroup>

  <!-- Entity Framework Core for the local demonstration database, approved 2026-10-14 (batch 2, Decision Log #53).
       Related EF Core components keep the same version. Only stable releases. No SQL Server provider here. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <!-- Migration tooling, approved 2026-10-14 (batch 3, Decision Log #56): design-time only, never shipped. Same version as EF Core
       and as the dotnet-ef tool pinned in .config/dotnet-tools.json. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

</Project>
