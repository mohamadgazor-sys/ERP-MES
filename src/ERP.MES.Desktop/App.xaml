<Application x:Class="ERP.MES.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: the main window is created in App.OnStartup (the composition root of the demonstration build). -->
    <Application.Resources>
        <!-- Persian UI font: Tahoma first, with the system fallbacks (Decision Log #48). No font is bundled. -->
        <FontFamily x:Key="UiFont">Tahoma, Segoe UI, Arial</FontFamily>

        <!-- Request, item and contract numbers are free-form Latin text/digits (for example DEMO-1405-015): in the right-to-left window they must read left to right, otherwise their parts are shown in reverse order. -->
        <Style x:Key="LtrCell" TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Toolbar buttons with long Persian captions (for example «جایگزینی مدیریت…», «پایان نوبت…»): a minimum width so that short captions do not shrink, and a caption that wraps instead of being cut at 1366x768 with 125% scaling (Decision Log #126 B6). -->
        <!-- Every button explains itself in a tooltip (purpose and consequence); a disabled button still shows it, so the user can see what the action is, and the tooltip also opens on keyboard focus (Decision Log #126). -->
        <Style TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>

        <Style x:Key="WrapButton" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MaxWidth" Value="250" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#1F4E79" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D5DBE1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6670" />
        <SolidColorBrush x:Key="DemoBannerBrush" Color="#FFF3CD" />
        <SolidColorBrush x:Key="DemoBannerTextBrush" Color="#664D03" />
    </Application.Resources>
</Application>
