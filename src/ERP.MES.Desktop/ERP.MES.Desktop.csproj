<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- The official name (also AppInfo.Name); the file keeps its technical name ERP.MES.Desktop.exe. -->
    <Product>برنامه جامع مدیریت و کنترل تولید ایران‌تول</Product>
    <AssemblyTitle>برنامه جامع مدیریت و کنترل تولید ایران‌تول</AssemblyTitle>
    <Description>برنامه جامع مدیریت و کنترل تولید ایران‌تول - نسخه نمایشی</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Non-secret authentication defaults (Milestone 1 plan 6.1). appsettings.Local.json is ignored by Git and may override them. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ERP.MES.Application\ERP.MES.Application.csproj" />
    <ProjectReference Include="..\..\src\ERP.MES.Infrastructure\ERP.MES.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ERP.MES.Infrastructure.Sqlite\ERP.MES.Infrastructure.Sqlite.csproj" />
  </ItemGroup>

</Project>
