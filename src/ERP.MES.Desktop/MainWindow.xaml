<Window x:Class="ERP.MES.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:ERP.MES.Desktop.ViewModels"
        xml:lang="fa-IR"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Background="{StaticResource SurfaceBrush}"
        Title="{Binding ApplicationTitle}"
        Width="1100" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Demonstration banner: always visible so nothing is mistaken for a finished feature. -->
        <Border Grid.Row="0" Background="{StaticResource DemoBannerBrush}" Padding="12,6">
            <TextBlock Text="{Binding DemoBanner}" Foreground="{StaticResource DemoBannerTextBrush}"
                       TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- First column sits on the right-hand side because the window flows right to left. -->
            <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
                <ListBox x:Name="NavigationList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:NavigationItem}">
                            <TextBlock Text="{Binding Title}" Padding="14,10" FontSize="15" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding CurrentTitle}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />
                <ContentControl x:Name="PageHost" Grid.Row="1" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
