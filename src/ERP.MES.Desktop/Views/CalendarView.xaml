<UserControl x:Class="ERP.MES.Desktop.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:CalendarViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:CalendarViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />

            <TextBlock Text="قالب شیفت‌ها" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="TemplateGrid" ItemsSource="{Binding Templates}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="160" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding CodeText}" Width="70" />
                    <DataGridTextColumn Header="نام" Binding="{Binding NameText}" Width="*" />
                    <DataGridTextColumn Header="ساعت‌ها" Binding="{Binding TimesText}" Width="*" />
                    <DataGridTextColumn Header="کار مفید" Binding="{Binding WorkingText}" Width="90" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanMaintain}">
                <TextBox x:Name="TplCode" Width="60" Margin="0,0,6,4" ToolTip="کد" />
                <TextBox x:Name="TplName" Width="140" Margin="0,0,6,4" ToolTip="نام" />
                <TextBox x:Name="TplStart" Width="60" Margin="0,0,6,4" ToolTip="شروع ۰۸:۰۰" />
                <TextBox x:Name="TplEnd" Width="60" Margin="0,0,6,4" ToolTip="پایان ۱۷:۰۰" />
                <TextBox x:Name="TplBreakStart" Width="60" Margin="0,0,6,4" ToolTip="شروع استراحت (اختیاری)" />
                <TextBox x:Name="TplBreakEnd" Width="60" Margin="0,0,6,4" ToolTip="پایان استراحت (اختیاری)" />
                <Button Content="افزودن قالب" Padding="10,3" Margin="0,0,6,4" Click="OnAddTemplate" />
                <Button Content="فعال/بازنشسته" Padding="10,3" Margin="0,0,6,4" Click="OnToggleTemplate" />
            </WrapPanel>

            <TextBlock Text="الگوی هفته" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="WeekGrid" ItemsSource="{Binding Weekdays}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="روز" Binding="{Binding DayText}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StateText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="تغییر کاری/تعطیل بودن روز انتخاب‌شده" Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnToggleWeekday" IsEnabled="{Binding CanMaintain}" />

            <TextBlock Text="تعطیلی‌ها و روزهای کاری اضافه" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="ExceptionGrid" ItemsSource="{Binding Exceptions}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="180" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="90" />
                    <DataGridTextColumn Header="نوع" Binding="{Binding KindText}" Width="110" />
                    <DataGridTextColumn Header="محدوده (واحد / شیفت)" Binding="{Binding ScopeText}" Width="*" />
                    <DataGridTextColumn Header="دلیل" Binding="{Binding ReasonText}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanMaintain}">
                <TextBox x:Name="ExDate" Width="90" Margin="0,0,6,4" ToolTip="تاریخ شمسی ۱۴۰۵/۰۷/۲۰" />
                <ComboBox x:Name="ExKind" ItemsSource="{Binding ExceptionKinds}" DisplayMemberPath="Text" SelectedIndex="0" Width="150" Margin="0,0,6,4" />
                <ComboBox x:Name="ExUnit" ItemsSource="{Binding Units}" DisplayMemberPath="Value.Name" Width="130" Margin="0,0,6,4" ToolTip="واحد (خالی = همه)" />
                <ComboBox x:Name="ExShift" ItemsSource="{Binding Templates}" DisplayMemberPath="CodeText" Width="70" Margin="0,0,6,4" ToolTip="شیفت (خالی = همه)" />
                <TextBox x:Name="ExReason" Width="220" Margin="0,0,6,4" ToolTip="دلیل (برای روز اضافه: مرجع تأیید سرپرست)" />
                <Button Content="ثبت استثنا" Padding="10,3" Margin="0,0,6,4" Click="OnAddException" />
                <Button Content="لغو استثنای انتخاب‌شده" Padding="10,3" Margin="0,0,6,4" Click="OnCancelException" />
                <Button Content="پاک‌کردن واحد/شیفت" Padding="10,3" Margin="0,0,6,4" Click="OnClearScope" />
            </WrapPanel>

            <TextBlock Text="شیفت‌های هر واحد و ظرفیت" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="UnitShiftGrid" ItemsSource="{Binding UnitShifts}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="180" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="واحد" Binding="{Binding UnitText}" Width="*" />
                    <DataGridTextColumn Header="شیفت" Binding="{Binding ShiftText}" Width="80" />
                    <DataGridTextColumn Header="ظرفیت (حداقل تا حداکثر)" Binding="{Binding CapacityText}" Width="*" />
                    <DataGridTextColumn Header="هم‌پوشانی" Binding="{Binding OverlapText}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanMaintain}">
                <ComboBox x:Name="UsUnit" ItemsSource="{Binding Units}" DisplayMemberPath="Value.Name" Width="140" Margin="0,0,6,4" />
                <ComboBox x:Name="UsShift" ItemsSource="{Binding Templates}" DisplayMemberPath="CodeText" Width="70" Margin="0,0,6,4" />
                <TextBox x:Name="UsMax" Width="50" Margin="0,0,6,4" ToolTip="حداکثر اپراتور" />
                <TextBox x:Name="UsMin" Width="50" Margin="0,0,6,4" Text="0" ToolTip="حداقل اپراتور" />
                <CheckBox x:Name="UsOverlap" Content="هم‌پوشانی را صریحاً علامت می‌زنم" Margin="0,4,6,4" />
                <Button Content="افزودن شیفت به واحد" Padding="10,3" Margin="0,0,6,4" Click="OnAddUnitShift" />
                <Button Content="فعال/بازنشسته" Padding="10,3" Margin="0,0,6,4" Click="OnToggleUnitShift" />
            </WrapPanel>

            <TextBlock Text="برنامهٔ اپراتورها" Style="{StaticResource SectionStyle}" />
            <WrapPanel>
                <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="RangeFrom" Width="90" Margin="0,0,6,4" ToolTip="از تاریخ" />
                <TextBox x:Name="RangeTo" Width="90" Margin="0,0,6,4" ToolTip="تا تاریخ" />
                <Button Content="نمایش بازه" Padding="10,3" Margin="0,0,6,4" Click="OnRange" />
            </WrapPanel>
            <DataGrid x:Name="ScheduleGrid" ItemsSource="{Binding Schedule}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="260" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="90" />
                    <DataGridTextColumn Header="اپراتور" Binding="{Binding OperatorText}" Width="*" />
                    <DataGridTextColumn Header="واحد" Binding="{Binding UnitText}" Width="*" />
                    <DataGridTextColumn Header="شیفت" Binding="{Binding ShiftText}" Width="70" />
                    <DataGridTextColumn Header="ماشین" Binding="{Binding MachineText}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="*" />
                    <DataGridTextColumn Header="علامت" Binding="{Binding FlagText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanScheduleWorkers}">
                <ComboBox x:Name="SchOperator" ItemsSource="{Binding OperatorChoices}" DisplayMemberPath="Value.FullName" Width="150" Margin="0,0,6,4" />
                <TextBox x:Name="SchDate" Width="90" Margin="0,0,6,4" ToolTip="تاریخ شمسی" />
                <ComboBox x:Name="SchUnit" ItemsSource="{Binding Units}" DisplayMemberPath="Value.Name" Width="130" Margin="0,0,6,4" />
                <ComboBox x:Name="SchShift" ItemsSource="{Binding Templates}" DisplayMemberPath="CodeText" Width="70" Margin="0,0,6,4" />
                <ComboBox x:Name="SchMachine" ItemsSource="{Binding Machines}" DisplayMemberPath="Value.Code" Width="90" Margin="0,0,6,4" ToolTip="ماشین (اختیاری)" />
                <TextBox x:Name="SchHandover" Width="60" Margin="0,0,6,4" ToolTip="دقیقهٔ هم‌پوشانی تحویل (اختیاری)" />
                <TextBox x:Name="SchNote" Width="140" Margin="0,0,6,4" ToolTip="یادداشت تحویل" />
                <Button Content="برنامه‌ریزی اپراتور" Padding="10,3" Margin="0,0,6,4" Click="OnSchedule" />
                <Button Content="لغو ردیف انتخاب‌شده…" Padding="10,3" Margin="0,0,6,4" Click="OnCancelSchedule" />
            </WrapPanel>

            <TextBlock Text="مرخصی و غیبت اپراتورها" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="OffDayGrid" ItemsSource="{Binding OffDays}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="180" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اپراتور" Binding="{Binding OperatorText}" Width="*" />
                    <DataGridTextColumn Header="بازه" Binding="{Binding RangeText}" Width="*" />
                    <DataGridTextColumn Header="نوع" Binding="{Binding KindText}" Width="90" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanScheduleWorkers}">
                <ComboBox x:Name="OffOperator" ItemsSource="{Binding OperatorChoices}" DisplayMemberPath="Value.FullName" Width="150" Margin="0,0,6,4" />
                <TextBox x:Name="OffFrom" Width="90" Margin="0,0,6,4" ToolTip="از تاریخ" />
                <TextBox x:Name="OffTo" Width="90" Margin="0,0,6,4" ToolTip="تا تاریخ" />
                <ComboBox x:Name="OffKind" ItemsSource="{Binding OffDayKinds}" DisplayMemberPath="Text" SelectedIndex="0" Width="100" Margin="0,0,6,4" />
                <TextBox x:Name="OffNote" Width="160" Margin="0,0,6,4" ToolTip="یادداشت" />
                <Button Content="ثبت مرخصی/غیبت" Padding="10,3" Margin="0,0,6,4" Click="OnAddOffDay" />
                <Button Content="لغو ردیف انتخاب‌شده" Padding="10,3" Margin="0,0,6,4" Click="OnCancelOffDay" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
