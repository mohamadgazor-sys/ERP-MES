<UserControl x:Class="ERP.MES.Desktop.Views.CompletionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:CompletionViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:CompletionViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />

            <DataGrid x:Name="CompletionGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="320" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="درخواست" Binding="{Binding RequestText}" Width="100" />
                    <DataGridTextColumn Header="آیتم" Binding="{Binding ItemText}" Width="*" />
                    <DataGridTextColumn Header="پذیرفته‌شده (واحد پایه)" Binding="{Binding QuantityText}" Width="90" />
                    <DataGridTextColumn Header="دریافت انبار" Binding="{Binding ReceiptText}" Width="*" />
                    <DataGridTextColumn Header="قیمت" Binding="{Binding PriceText}" Width="*" />
                    <DataGridTextColumn Header="تکمیل/ارسال" Binding="{Binding FinishedText}" Width="*" />
                    <DataGridTextColumn Header="ارسال به مشتری" Binding="{Binding DispatchText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Visibility="{Binding CanReceive, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                <WrapPanel>
                    <TextBox x:Name="ReceiptNoteBox" Width="220" Margin="0,0,6,4" ToolTip="یادداشت دریافت (اختیاری)" />
                    <Button Content="ثبت دریافت نهایی" Padding="10,3" Margin="0,0,6,4" Click="OnReceive" ToolTip="دریافت آیتم در انبار را ثبت می‌کند؛ فقط انبار." />
                    <Button Content="تکمیل/ارسال شد" Padding="10,3" Margin="0,0,6,4" Click="OnFinished" ToolTip="وضعیت تکمیل یا ارسال آیتم را ثبت می‌کند." />
                </WrapPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding CanDispatch, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ارسال به مشتری (اختیاری)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,4" />
                <WrapPanel>
                    <TextBox x:Name="DispatchDateBox" Width="90" Margin="0,0,6,4" ToolTip="تاریخ شمسی" />
                    <TextBox x:Name="DispatchReferenceBox" Width="140" Margin="0,0,6,4" ToolTip="شمارهٔ سند" />
                    <TextBox x:Name="DispatchNoteBox" Width="200" Margin="0,0,6,4" ToolTip="یادداشت" />
                    <Button Content="ثبت ارسال" Padding="10,3" Margin="0,0,6,4" Click="OnDispatch" ToolTip="ارسال محصول به مشتری را ثبت می‌کند." />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
