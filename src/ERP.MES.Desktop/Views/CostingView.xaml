<UserControl x:Class="ERP.MES.Desktop.Views.CostingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:CostingViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:CostingViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />

            <DataGrid x:Name="CostGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="300" Background="{StaticResource CardBrush}" SelectionChanged="OnSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="درخواست" Binding="{Binding RequestText}" Width="100" />
                    <DataGridTextColumn Header="آیتم" Binding="{Binding ItemText}" Width="*" />
                    <DataGridTextColumn Header="پذیرفته‌شده (واحد پایه)" Binding="{Binding QuantityText}" Width="90" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="*" />
                    <DataGridTextColumn Header="هزینه" Binding="{Binding CostText}" Width="*" />
                    <DataGridTextColumn Header="قیمت" Binding="{Binding PriceText}" Width="*" />
                    <DataGridTextColumn Header="ثبت‌کنندگان" Binding="{Binding ActorText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <ItemsControl ItemsSource="{Binding Detail}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Visibility="{Binding CanCalculate, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="محاسبهٔ هزینه" Padding="10,3" Margin="0,0,6,4" Click="OnCalculate" ToolTip="هزینهٔ آیتم را از زمان‌های واقعی، نرخ ماشین و قیمت ماده محاسبه و به‌صورت یک نسخهٔ جدید ذخیره می‌کند." />
                    <Button Content="ارسال قیمت به مدیریت" Padding="10,3" Margin="0,0,6,4" Click="OnSubmit" ToolTip="قیمت محاسبه‌شده را برای تأیید به مدیریت می‌فرستد." />
                </StackPanel>
            </WrapPanel>
            <StackPanel Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="تصمیم قیمت (مدیریت)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,4" />
                <WrapPanel>
                    <TextBox x:Name="PriceBox" Width="140" Margin="0,0,6,4" ToolTip="قیمت به ریال (خالی = پیشنهاد محاسبه‌شده)" />
                    <TextBox x:Name="ReasonBox" Width="200" Margin="0,0,6,4" ToolTip="دلیل تغییر قیمت" />
                    <TextBox x:Name="ReferenceBox" Width="120" Margin="0,0,6,4" ToolTip="شمارهٔ قرارداد (آیتم قراردادی)" />
                    <Button Content="تأیید قیمت" Padding="10,3" Margin="0,0,6,4" Click="OnApprove" ToolTip="قیمت محاسبه‌شده را تأیید می‌کند؛ فقط مدیریت." />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
