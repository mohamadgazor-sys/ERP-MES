<UserControl x:Class="ERP.MES.Desktop.Views.DowntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LtrCell" TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:DowntimeViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:DowntimeViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />

            <WrapPanel>
                <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="RangeFrom" Width="90" Margin="0,0,6,4" ToolTip="از تاریخ (شمسی)" />
                <TextBox x:Name="RangeTo" Width="90" Margin="0,0,6,4" ToolTip="تا تاریخ (شمسی)" />
                <Button Content="نمایش بازه" Padding="10,3" Margin="0,0,6,4" Click="OnRange" ToolTip="توقف‌هایی را که با بازهٔ تاریخ واردشده هم‌پوشانی دارند نشان می‌دهد. چیزی تغییر نمی‌کند." />
            </WrapPanel>
            <DataGrid x:Name="DowntimeGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="320" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ماشین" Binding="{Binding MachineText}" Width="80" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="واحد" Binding="{Binding UnitText}" Width="90" />
                    <DataGridTextColumn Header="علت" Binding="{Binding ReasonText}" Width="120" />
                    <DataGridTextColumn Header="شروع" Binding="{Binding StartText}" Width="110" />
                    <DataGridTextColumn Header="پایان" Binding="{Binding EndText}" Width="110" />
                    <DataGridTextColumn Header="مدت" Binding="{Binding DurationText}" Width="80" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="*" />
                    <DataGridTextColumn Header="توضیح" Binding="{Binding NoteText}" Width="*" />
                    <DataGridTextColumn Header="ثبت‌کننده" Binding="{Binding ReporterText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Visibility="{Binding CanDecide, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="تأیید توقف" Padding="10,3" Margin="0,0,6,4" Click="OnAccept" ToolTip="توقف انتخاب‌شده را پس از بررسی تأیید می‌کند؛ همچنان از زمان در دسترس ماشین کم می‌شود. فقط برنامه‌ریزی." />
                    <Button Content="رد توقف…" Padding="10,3" Margin="0,0,6,4" Click="OnReject" ToolTip="توقف انتخاب‌شده را با دلیلی که می‌نویسید رد می‌کند؛ دیگر در پیش‌بینی پایان کارها اثر ندارد و سابقه می‌ماند. فقط برنامه‌ریزی." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="اصلاح پایان…" Padding="10,3" Margin="0,0,6,4" Click="OnChangeEnd" ToolTip="پایان توقف انتخاب‌شده را با دلیل اصلاح می‌کند (تاریخ و ساعت از کادرهای پایان پایین)؛ توقف تأییدشده دوباره به بررسی برنامه‌ریزی برمی‌گردد." />
                    <Button Content="لغو با دلیل…" Padding="10,3" Margin="0,0,6,4" Click="OnCancel" ToolTip="توقف انتخاب‌شده را با دلیلی که می‌نویسید لغو می‌کند؛ دیگر اثر ندارد و سابقه می‌ماند. فقط نگهداری و تعمیرات." />
                </StackPanel>
            </WrapPanel>

            <StackPanel Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ثبت توقف ماشین" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,14,0,4" />
                <WrapPanel>
                    <ComboBox x:Name="MachineBox" FlowDirection="LeftToRight" ItemsSource="{Binding Machines}" DisplayMemberPath="Code" Width="100" Margin="0,0,6,4" ToolTip="ماشین (فقط ماشین‌های فعال)" />
                    <ComboBox x:Name="ReasonBox" ItemsSource="{x:Static vm:DowntimeViewModel.Reasons}" DisplayMemberPath="Text" Width="170" Margin="0,0,6,4" ToolTip="علت توقف" />
                    <TextBox x:Name="StartDateBox" Width="90" Margin="0,0,6,4" ToolTip="تاریخ شروع (شمسی، مثال ۱۴۰۵/۰۸/۱۴)" />
                    <TextBox x:Name="StartTimeBox" Width="60" Margin="0,0,6,4" ToolTip="ساعت شروع (۲۴ ساعته، مثال ۰۹:۳۰)" />
                    <TextBox x:Name="EndDateBox" Width="90" Margin="0,0,6,4" ToolTip="تاریخ پایان (شمسی)؛ خالی یعنی همان روز شروع، یا روز بعد اگر ساعت پایان از ساعت شروع زودتر باشد" />
                    <TextBox x:Name="EndTimeBox" Width="60" Margin="0,0,6,4" ToolTip="ساعت پایان (۲۴ ساعته)" />
                    <TextBox x:Name="NoteBox" Width="220" Margin="0,0,6,4" ToolTip="توضیح (برای علت «سایر» الزامی؛ حداکثر ۳۰۰ نویسه)" />
                    <Button Content="ثبت توقف" Padding="10,3" Margin="0,0,6,4" Click="OnReport" ToolTip="توقف ماشین را ثبت می‌کند؛ از همین لحظه از زمان در دسترس ماشین کم می‌شود و برای بررسی به برنامه‌ریزی می‌رود. فقط نگهداری و تعمیرات." />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
