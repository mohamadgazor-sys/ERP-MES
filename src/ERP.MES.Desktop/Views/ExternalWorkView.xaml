<UserControl x:Class="ERP.MES.Desktop.Views.ExternalWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:ExternalWorkViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:ExternalWorkViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />
            <WrapPanel>
                <CheckBox Content="نمایش مرحله‌های تکمیل‌شده و آزادنشده" IsChecked="{Binding IncludeCompleted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                <Button Content="بارگذاری دوباره" Padding="10,3" Margin="0,0,6,4" Click="OnReload" ToolTip="فهرست مرحله‌های بیرونی را دوباره از پایگاه داده می‌خواند. چیزی تغییر نمی‌کند." />
            </WrapPanel>
            <DataGrid x:Name="StageGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="300" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="درخواست — مشتری" Binding="{Binding RequestText}" Width="140" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="آیتم" Binding="{Binding ItemText}" Width="130" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="مرحله" Binding="{Binding StageText}" Width="130" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="مسیر بیرونی" Binding="{Binding UnitText}" Width="150" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="140" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="مقدارها (واحد پایه)" Binding="{Binding QuantitiesText}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="ارسال‌های باز" Binding="{Binding OpenText}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="سابقهٔ ارسال و برگشت مرحلهٔ انتخاب‌شده" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,12,0,4" />
            <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ثبت" Binding="{Binding KindText}" Width="150" />
                    <DataGridTextColumn Header="زمان" Binding="{Binding WhenText}" Width="130" />
                    <DataGridTextColumn Header="مقدار" Binding="{Binding QuantityText}" Width="100" />
                    <DataGridTextColumn Header="کاربر" Binding="{Binding UserText}" Width="*" />
                    <DataGridTextColumn Header="شرح و توضیح" Binding="{Binding NoteText}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="وضعیت ثبت" Binding="{Binding StateText}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Visibility="{Binding CanRecord, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ثبت توسط انبار" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,12,0,4" />
                <WrapPanel>
                    <TextBox x:Name="DispatchQuantityBox" Width="70" Margin="0,0,6,4" FlowDirection="LeftToRight" ToolTip="مقدار ارسال (واحد پایه)؛ حداکثر به اندازهٔ مانده برای ارسال" />
                    <TextBox x:Name="PieceBox" Width="170" Margin="0,0,6,4" ToolTip="شرح قطعه‌های ارسالی (اختیاری، حداکثر ۳۰۰ نویسه)" />
                    <TextBox x:Name="DispatchNoteBox" Width="170" Margin="0,0,6,4" ToolTip="توضیح ارسال (اختیاری)" />
                    <Button Content="ثبت ارسال" Padding="10,3" Margin="0,0,6,4" Click="OnDispatch" ToolTip="ارسال مقدار واردشده از مرحلهٔ انتخاب‌شده به مسیر بیرونی را با زمان همین لحظه و نام شما ثبت می‌کند. فقط انبار." />
                </WrapPanel>
                <WrapPanel>
                    <ComboBox x:Name="DispatchBox" ItemsSource="{Binding OpenDispatches}" DisplayMemberPath="Text" Width="220" Margin="0,0,6,4" ToolTip="ارسالی که قطعه‌ها از آن برمی‌گردند" />
                    <TextBox x:Name="ReturnQuantityBox" Width="70" Margin="0,0,6,4" FlowDirection="LeftToRight" ToolTip="مقدار برگشت (واحد پایه)؛ حداکثر به اندازهٔ ماندهٔ همان ارسال" />
                    <TextBox x:Name="ReturnNoteBox" Width="170" Margin="0,0,6,4" ToolTip="توضیح برگشت (اختیاری)" />
                    <Button Content="ثبت برگشت" Padding="10,3" Margin="0,0,6,4" Click="OnReturn" ToolTip="برگشت مقدار واردشده از ارسال انتخاب‌شده را ثبت می‌کند؛ واحدها به کنترل کیفیت می‌روند. این دریافت نهایی انبار نیست. فقط انبار." />
                    <Button Content="لغو ثبت انتخاب‌شده در سابقه…" Padding="10,3" Margin="0,0,6,4" Click="OnCancel" ToolTip="ارسال یا برگشتی را که در جدول سابقه انتخاب کرده‌اید با دلیل لغو می‌کند؛ ارسالِ دارای برگشت و برگشتی که کنترل کیفیت درباره‌اش تصمیم گرفته لغو نمی‌شود. ثبت در سابقه می‌ماند." />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
