<UserControl x:Class="ERP.MES.Desktop.Views.JobReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:JobReportsViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:JobReportsViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />

            <WrapPanel>
                <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="RangeFrom" Width="90" Margin="0,0,6,4" ToolTip="از تاریخ" />
                <TextBox x:Name="RangeTo" Width="90" Margin="0,0,6,4" ToolTip="تا تاریخ" />
                <Button Content="نمایش بازه" Padding="10,3" Margin="0,0,6,4" Click="OnRange" ToolTip="فهرست را برای بازهٔ تاریخ واردشده نشان می‌دهد. چیزی تغییر نمی‌کند." />
            </WrapPanel>
            <DataGrid x:Name="ReportGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="280" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="90" />
                    <DataGridTextColumn Header="اپراتور" Binding="{Binding OperatorText}" Width="*" />
                    <DataGridTextColumn Header="واحد" Binding="{Binding UnitText}" Width="*" />
                    <DataGridTextColumn Header="شیفت" Binding="{Binding ShiftText}" Width="60" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="*" />
                    <DataGridTextColumn Header="ردیف‌های کار" Binding="{Binding LinesText}" Width="*" />
                    <DataGridTextColumn Header="علامت" Binding="{Binding FlagsText}" Width="*" />
                    <DataGridTextColumn Header="بررسی" Binding="{Binding ReviewText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanReview}">
                <Button Content="تأیید گزارش" Padding="10,3" Margin="0,0,6,4" Click="OnApprove" ToolTip="گزارش ارسال‌شده را تأیید می‌کند؛ پس از تأیید قابل تغییر نیست." />
                <Button Content="بازگرداندن با دلیل…" Padding="10,3" Margin="0,0,6,4" Click="OnReturn" ToolTip="گزارش را با دلیل به اپراتور برمی‌گرداند تا اصلاح کند." />
            </WrapPanel>

            <StackPanel Visibility="{Binding CanSubmit, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="گزارش من" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,14,0,4" />
                <WrapPanel>
                    <TextBox x:Name="ReportDate" Width="90" Margin="0,0,6,4" ToolTip="تاریخ شمسی گزارش" />
                    <ComboBox x:Name="UnitBox" ItemsSource="{Binding Units}" DisplayMemberPath="Name" Width="150" Margin="0,0,6,4" SelectionChanged="OnUnitChanged" />
                    <ComboBox x:Name="ShiftBox" FlowDirection="LeftToRight" ItemsSource="{Binding Templates}" DisplayMemberPath="Value.Code" Width="70" Margin="0,0,6,4" />
                    <Button Content="ویرایش گزارش انتخاب‌شده" Padding="10,3" Margin="0,0,6,4" Click="OnEdit" ToolTip="گزارش انتخاب‌شده را برای ویرایش باز می‌کند؛ فقط پیش‌نویس یا گزارش برگشتی قابل ویرایش است." />
                </WrapPanel>
                <WrapPanel>
                    <ComboBox x:Name="StageBox" ItemsSource="{Binding Stages}" DisplayMemberPath="Text" Width="300" Margin="0,0,6,4" />
                    <ComboBox x:Name="MachineBox" FlowDirection="LeftToRight" ItemsSource="{Binding Machines}" DisplayMemberPath="Value.Code" Width="90" Margin="0,0,6,4" />
                    <TextBox x:Name="StartBox" Width="60" Margin="0,0,6,4" ToolTip="شروع ۰۸:۰۰" />
                    <TextBox x:Name="EndBox" Width="60" Margin="0,0,6,4" ToolTip="پایان ۱۲:۰۰" />
                    <TextBox x:Name="DowntimeBox" Width="60" Margin="0,0,6,4" Text="0" ToolTip="دقیقهٔ توقف" />
                    <TextBox x:Name="DowntimeReasonBox" Width="140" Margin="0,0,6,4" ToolTip="دلیل توقف" />
                    <TextBox x:Name="UnitsBox" Width="60" Margin="0,0,6,4" ToolTip="واحد پایهٔ فرآوری‌شده" />
                    <TextBox x:Name="NoteBox" Width="140" Margin="0,0,6,4" ToolTip="یادداشت" />
                    <Button Content="افزودن ردیف" Padding="10,3" Margin="0,0,6,4" Click="OnAddLine" ToolTip="ردیف کار واردشده را به پیش‌نویس گزارش اضافه می‌کند؛ برای ثبت باید پیش‌نویس ذخیره شود." />
                </WrapPanel>
                <DataGrid x:Name="DraftGrid" ItemsSource="{Binding Draft}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="200" Background="{StaticResource CardBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="مرحله" Binding="{Binding StageText}" Width="*" />
                        <DataGridTextColumn Header="ماشین" Binding="{Binding MachineText}" Width="90" />
                        <DataGridTextColumn Header="ساعت" Binding="{Binding TimeText}" Width="140" />
                        <DataGridTextColumn Header="واحد پایه" Binding="{Binding UnitsText}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="حذف ردیف انتخاب‌شده" Padding="10,3" Margin="0,0,6,4" Click="OnRemoveLine" ToolTip="ردیف انتخاب‌شده را از پیش‌نویس برمی‌دارد؛ تا ذخیرهٔ پیش‌نویس در پایگاه داده اثری ندارد." />
                    <Button Content="ذخیرهٔ پیش‌نویس" Padding="10,3" Margin="0,0,6,4" Click="OnSaveDraft" ToolTip="گزارش را به‌صورت پیش‌نویس ذخیره می‌کند؛ هنوز برای سرپرست ارسال نشده و قابل ویرایش است." />
                    <Button Content="ارسال گزارش" Padding="10,3" Margin="0,0,6,4" Click="OnSubmit" ToolTip="گزارش را برای بررسی سرپرست ارسال می‌کند؛ پس از ارسال تا برگشت قابل ویرایش نیست." />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
