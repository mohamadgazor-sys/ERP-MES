<UserControl x:Class="ERP.MES.Desktop.Views.KpiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:KpiViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:KpiViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />
            <WrapPanel>
                <TextBox x:Name="RangeFrom" Width="90" Margin="0,0,6,4" ToolTip="از تاریخ" />
                <TextBox x:Name="RangeTo" Width="90" Margin="0,0,6,4" ToolTip="تا تاریخ" />
                <Button Content="نمایش بازه" Padding="10,3" Margin="0,0,6,4" Click="OnRange" ToolTip="فهرست را برای بازهٔ تاریخ واردشده نشان می‌دهد. چیزی تغییر نمی‌کند." />
            </WrapPanel>
            <TextBlock Text="{Binding RunText}" Margin="0,0,0,6" TextWrapping="Wrap" />
            <DataGrid ItemsSource="{Binding Units}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="320" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="واحد" Binding="{Binding UnitText}" Width="*" />
                    <DataGridTextColumn Header="ساعت مفید (واقعی)" Binding="{Binding HoursText}" Width="*" />
                    <DataGridTextColumn Header="اضافه‌کاری" Binding="{Binding OvertimeText}" Width="*" />
                    <DataGridTextColumn Header="مقدار (واحد پایه)" Binding="{Binding QuantityText}" Width="2*" />
                    <DataGridTextColumn Header="نسبت‌ها" Binding="{Binding RatesText}" Width="2*" />
                    <DataGridTextColumn Header="برنامه در برابر واقعی" Binding="{Binding PlanText}" Width="2*" />
                    <DataGridTextColumn Header="بهره‌وری" Binding="{Binding UtilizationText}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="رتبهٔ اپراتورها (فقط بر پایهٔ ساعت مفید)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,14,0,4" />
            <DataGrid ItemsSource="{Binding Operators}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="260" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رتبه" Binding="{Binding RankText}" Width="60" />
                    <DataGridTextColumn Header="اپراتور" Binding="{Binding OperatorText}" Width="*" />
                    <DataGridTextColumn Header="ساعت مفید" Binding="{Binding HoursText}" Width="*" />
                    <DataGridTextColumn Header="روزهای کار" Binding="{Binding DaysText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
