<UserControl x:Class="ERP.MES.Desktop.Views.LimitationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="24" CornerRadius="6" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="آنچه در این نسخه نمایشی نیست" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="26"
                           Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="• استقرار تولیدی: نسخهٔ SQL Server برنامه و مهاجرت‌هایش روی یک SQL Server آزمایشی بررسی شده‌اند، اما انتخاب و تأیید سرور تولیدی، پشتیبان‌گیری و نصب چندکاربره هنوز انجام نشده است." /><LineBreak />
                    <Run Text="• تأمین بیرونی و کار پیمانکاری به‌شکل مرحلهٔ تولید (ارسال، برگشت، زمان تحویل بیرونی) هنوز ساخته نشده است." /><LineBreak />
                    <Run Text="• پایان پیش‌بینی‌شده فقط تخمین است: هر واحد یک خط کار دارد، توقف ماشین‌ها کم می‌شود، اما ظرفیت چند ماشین موازی و زمان تحویل بیرونی در آن نیست." /><LineBreak />
                    <Run Text="• درصد پیشرفت درخواست‌ها (تعریف آن منتظر تصمیم مالک است)." /><LineBreak />
                    <Run Text="• فرمول پاداش و رتبه‌بندی عملکرد (فاز ۲)." /><LineBreak />
                    <Run Text="• ماتریس کامل نقش‌ها و مجوزها: فقط مجوزهای تأییدشده فعال‌اند و بقیه ممنوع است." /><LineBreak />
                    <Run Text="• قواعدی که در ثبت تصمیم‌ها «پیش‌فرض» یا «فرض» نامیده شده‌اند (مثل سقف‌ها و جزئیات توقف ماشین) منتظر تأیید مالک‌اند و ممکن است تغییر کنند." />
                </TextBlock>
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                           Text="همهٔ مشتریان، درخواست‌ها و کاربران در این نسخه فرضی هستند." />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
