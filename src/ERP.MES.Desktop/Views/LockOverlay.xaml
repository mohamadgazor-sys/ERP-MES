<UserControl x:Class="ERP.MES.Desktop.Views.LockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource UiFont}"
             FontSize="14">
    <!-- Opaque: nothing of the application shows behind it. It shows only who is signed in and what is needed to continue. -->
    <Grid Background="{StaticResource SurfaceBrush}">
        <Border Width="440" Padding="24" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="نشست قفل شده است" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock x:Name="UserText" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock x:Name="ReasonText" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#9B1C1C" FontWeight="SemiBold" Margin="0,0,0,12" />

                <StackPanel x:Name="UnlockPanel">
                    <TextBlock Text="برای ادامه، گذرواژه خود را وارد کنید." Margin="0,0,0,6" />
                    <PasswordBox x:Name="UnlockPassword" Margin="0,0,0,12" />
                    <Button Content="باز کردن قفل" Click="OnUnlockClick" Padding="12,6" IsDefault="True" ToolTip="قفل حساب بر اثر ورود ناموفق را برمی‌دارد تا کاربر دوباره بتواند وارد شود." />
                </StackPanel>

                <StackPanel x:Name="ChangePanel" Visibility="Collapsed">
                    <TextBlock Text="گذرواژه فعلی" />
                    <PasswordBox x:Name="CurrentPassword" Margin="0,2,0,8" />
                    <TextBlock Text="گذرواژه جدید" />
                    <PasswordBox x:Name="NewPassword" Margin="0,2,0,8" />
                    <TextBlock Text="تکرار گذرواژه جدید" />
                    <PasswordBox x:Name="NewPasswordRepeat" Margin="0,2,0,12" />
                    <Button Content="تغییر گذرواژه" Click="OnChangePasswordClick" Padding="12,6" IsDefault="True" ToolTip="گذرواژهٔ شما را عوض می‌کند. بعد از آن باید با گذرواژهٔ جدید وارد شوید." />
                </StackPanel>

                <Button Content="ورود با کاربر دیگر" Click="OnSwitchUserClick" Margin="0,16,0,0" Padding="12,6" ToolTip="از حساب فعلی خارج می‌شود و صفحهٔ ورود را باز می‌کند." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
