<UserControl x:Class="ERP.MES.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="24" CornerRadius="6" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
    </Border>
</UserControl>
