<UserControl x:Class="ERP.MES.Desktop.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#9B1C1C" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="در حال بارگذاری…" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- New request (Central). The request number is the customer's own text and is stored exactly as typed. -->
            <Expander Header="ثبت درخواست جدید" Margin="0,0,0,12" IsEnabled="{Binding CanCreateRequest}">
                <Border Padding="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="مشتری" />
                            <ComboBox x:Name="CustomerBox" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" Margin="0,2,0,8" />
                            <TextBlock Text="شمارهٔ درخواست مشتری (بدون تغییر ذخیره می‌شود؛ حروف بزرگ و کوچک متفاوت‌اند)" TextWrapping="Wrap" />
                            <TextBox x:Name="RequestNoBox" FlowDirection="LeftToRight" Margin="0,2,0,8" />
                            <TextBlock Text="نوع کار درخواست (ساخت یا تعمیر؛ یک نوع برای کل درخواست)" TextWrapping="Wrap" />
                            <ComboBox x:Name="CreateWorkTypeBox" ItemsSource="{Binding WorkTypes}" DisplayMemberPath="Text" Margin="0,2,0,8" />
                            <TextBlock Text="تاریخ درخواست (شمسی، مثال: ۱۴۰۵/۰۷/۲۰)" />
                            <TextBox x:Name="DateBox" FlowDirection="LeftToRight" Margin="0,2,0,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="عنوان (اختیاری)" />
                            <TextBox x:Name="TitleBox" Margin="0,2,0,8" />
                            <TextBlock Text="توضیحات (اختیاری)" />
                            <TextBox x:Name="DescriptionBox" Margin="0,2,0,8" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />
                            <Button Content="ثبت درخواست" Padding="12,5" HorizontalAlignment="Left" Click="OnCreateClick" ToolTip="درخواست مشتری را با شماره و تاریخ واردشده ثبت می‌کند. شماره بعداً تغییر نمی‌کند." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>

            <TextBlock Text="درخواست‌ها" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12" Height="200">
                <DataGrid x:Name="RequestGrid" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest, Mode=TwoWay}"
                          SelectionChanged="OnRequestSelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" Background="{StaticResource CardBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شمارهٔ درخواست" Binding="{Binding RequestNo}" ElementStyle="{StaticResource LtrCell}" Width="130" />
                        <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="نوع کار" Binding="{Binding WorkTypeText}" Width="80" />
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="100" />
                        <DataGridTextColumn Header="سال شمسی" Binding="{Binding YearText}" Width="80" />
                        <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="170" />
                        <DataGridTextColumn Header="آیتم‌ها" Binding="{Binding ItemCount}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="هنوز درخواستی ثبت نشده است." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="16"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Selected request. -->
            <Border Padding="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding DetailHeading}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailLine}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailTitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailDescription}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding PdfText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="پیوست یا جایگزینی PDF" Padding="12,5" Margin="0,0,8,0" Click="OnAttachPdfClick" IsEnabled="{Binding CanAttachPdf}" ToolTip="فایل PDF درخواست را پیوست می‌کند. اگر فایلی بوده، فایل جدید جای آن می‌نشیند و قبلی در سابقه می‌ماند." />
                        <Button Content="مشاهدهٔ PDF" Padding="12,5" Click="OnViewPdfClick" IsEnabled="{Binding HasPdf}" ToolTip="فایل PDF را با برنامهٔ PDF باز می‌کند." />
                    </StackPanel>
                    <Button Content="ارسال به مدیریت" Padding="12,5" Margin="0,8,0,8" HorizontalAlignment="Left" Click="OnSubmitClick" IsEnabled="{Binding CanSubmit}" ToolTip="درخواست را برای تأیید یا رد به مدیریت می‌فرستد؛ بعد از ارسال دیگر قابل ویرایش نیست." />

                    <!-- Request lifecycle after submission (Decision Log #29, #82). Buttons appear only for the user and status that allow them; the Application checks again. -->
                    <Border Padding="8" Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            Visibility="{Binding HasWorkflowActions, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="اقدامات گردش کار" FontWeight="SemiBold" />
                            <TextBlock Text="دلیل / توضیح (برای رد، بازگشایی، بازگشت به نقشه‌کشی و نتیجهٔ نقشه‌کشی)" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBox x:Name="ReasonBox" TextWrapping="Wrap" AcceptsReturn="True" Height="52" Margin="0,2,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="نتیجهٔ نقشه‌کشی:" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding CanRecordDrawingResult, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox x:Name="OutcomeBox" ItemsSource="{Binding DrawingOutcomes}" DisplayMemberPath="Text" Width="200" Margin="0,0,8,0"
                                          Visibility="{Binding CanRecordDrawingResult, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="تأیید" Padding="12,5" Margin="0,0,8,4" Click="OnApproveClick" Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" ToolTip="انتخاب یا مقدار واردشده را تأیید می‌کند." />
                                <Button Content="رد (با دلیل)" Padding="12,5" Margin="0,0,8,4" Click="OnRejectClick" Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibility}}" ToolTip="درخواست را با دلیلی که می‌نویسید رد می‌کند." />
                                <Button Content="بازگشایی (با دلیل)" Padding="12,5" Margin="0,0,8,4" Click="OnReopenClick" Visibility="{Binding CanReopen, Converter={StaticResource BoolToVisibility}}" ToolTip="درخواست ردشده را با دلیل دوباره باز می‌کند تا ارسال شود." />
                                <Button Content="ارسال به نقشه‌کشی" Padding="12,5" Margin="0,0,8,4" Click="OnForwardClick" Visibility="{Binding CanForwardToDrawing, Converter={StaticResource BoolToVisibility}}" ToolTip="درخواست را برای بررسی فنی به نقشه‌کشی می‌فرستد." />
                                <Button Content="ثبت نتیجهٔ نقشه‌کشی" Padding="12,5" Margin="0,0,8,4" Click="OnDrawingResultClick" Visibility="{Binding CanRecordDrawingResult, Converter={StaticResource BoolToVisibility}}" ToolTip="نتیجهٔ بررسی فنی (پذیرش کامل یا جزئی، رد، نیاز به اطلاعات، بازگشت برای اصلاح) را ثبت می‌کند و درخواست را به برنامه‌ریزی برمی‌گرداند." />
                                <Button Content="بازگشت به نقشه‌کشی (با دلیل)" Padding="12,5" Margin="0,0,8,4" Click="OnSendBackClick" Visibility="{Binding CanSendBackToDrawing, Converter={StaticResource BoolToVisibility}}" ToolTip="آیتم را با دلیل برای بررسی دوباره به نقشه‌کشی برمی‌گرداند." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="تاریخچهٔ گردش کار" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="160" Background="{StaticResource CardBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="زمان" Binding="{Binding DateText}" Width="140" />
                            <DataGridTextColumn Header="اقدام" Binding="{Binding ActionText}" Width="170" />
                            <DataGridTextColumn Header="تغییر وضعیت" Binding="{Binding StatusChangeText}" Width="*" />
                            <DataGridTextColumn Header="واحد" Binding="{Binding DepartmentText}" Width="100" />
                            <DataGridTextColumn Header="انجام‌دهنده" Binding="{Binding ActorText}" Width="160" />
                            <DataGridTextColumn Header="نتیجه" Binding="{Binding OutcomeText}" Width="130" />
                            <DataGridTextColumn Header="دلیل / توضیح" Binding="{Binding NoteText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="هنوز اقدامی در گردش کار این درخواست ثبت نشده است." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,8"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="آیتم‌ها" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="220" Background="{StaticResource CardBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شمارهٔ آیتم" Binding="{Binding ItemNo}" ElementStyle="{StaticResource LtrCell}" Width="110" />
                            <DataGridTemplateColumn Header="نقشه" Width="64">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="نقشه" Padding="6,1" MinWidth="48" Click="OnOpenDrawingClick" ToolTip="نقشهٔ فنی این آیتم (فایل PDF) را باز می‌کند. نقشه فقط با همین کلیک خوانده می‌شود؛ اگر نقشه‌ای بارگذاری نشده باشد پیام می‌دهد." />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                            <DataGridTextColumn Header="نام قطعه" Binding="{Binding PartName}" Width="*" />
                            <DataGridTextColumn Header="نوع کار" Binding="{Binding WorkTypeText}" Width="80" />
                            <DataGridTextColumn Header="تعداد" Binding="{Binding QuantityText}" Width="90" />
                            <DataGridTextColumn Header="اولویت" Binding="{Binding PriorityText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="این درخواست هنوز آیتمی ندارد." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"
                               Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="تعریف آیتم و مرحله‌ها با برنامه‌ریزی است و پس از برقرار شدن دروازه‌ها در صفحهٔ «تعریف آیتم‌ها» انجام می‌شود." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
