<UserControl x:Class="ERP.MES.Desktop.Views.StageWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{x:Static vm:StageWorkViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:StageWorkViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <WrapPanel Margin="0,0,0,8">
                <Button Content="آزادسازی مرحلهٔ اول (برنامه‌ریزی)" Padding="12,5" Margin="0,0,8,4" Click="OnReleaseClick" IsEnabled="{Binding CanRelease}" />
                <Button Content="شروع مرحله (تولید)" Padding="12,5" Margin="0,0,8,4" Click="OnStartClick" IsEnabled="{Binding CanStart}" />
                <Button Content="ارسال به کنترل کیفیت (تولید)" Padding="12,5" Margin="0,0,8,4" Click="OnSubmitClick" IsEnabled="{Binding CanSubmitForQc}" />
                <Button Content="تأیید کنترل کیفیت — کل تعداد" Padding="12,5" Margin="0,0,8,4" Click="OnApproveClick" IsEnabled="{Binding CanApprove}" />
                <Button Content="بارگذاری دوباره" Padding="12,5" Margin="0,0,8,4" Click="OnReloadClick" />
            </WrapPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />
            <TextBlock Text="{x:Static vm:StageWorkViewModel.LoadingText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{x:Static vm:StageWorkViewModel.EmptyText}" FontSize="16" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,8" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" Background="{StaticResource CardBrush}"
                  Visibility="{Binding ShowRows, Converter={StaticResource BoolToVisibility}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ردیف" Binding="{Binding Display.Position}" Width="50" />
                <DataGridTextColumn Header="شمارهٔ درخواست" Binding="{Binding Display.RequestNo}" Width="120" />
                <DataGridTextColumn Header="مشتری" Binding="{Binding Display.CustomerName}" Width="130" />
                <DataGridTextColumn Header="شمارهٔ آیتم" Binding="{Binding Display.ItemNo}" Width="90" />
                <DataGridTextColumn Header="نام قطعه" Binding="{Binding Display.PartName}" Width="130" />
                <DataGridTextColumn Header="نوع کار" Binding="{Binding Display.WorkTypeText}" Width="70" />
                <DataGridTextColumn Header="اولویت" Binding="{Binding Display.PriorityText}" Width="80" />
                <DataGridTextColumn Header="مرحلهٔ جاری" Binding="{Binding Display.CurrentStageText}" Width="170" />
                <DataGridTextColumn Header="وضعیت مرحله" Binding="{Binding Display.StageStatusText}" Width="170" />
                <DataGridTextColumn Header="وضعیت کنترل کیفیت" Binding="{Binding Display.QcStatusText}" Width="230" />
                <DataGridTextColumn Header="مدت پردازش تخمینی مرحلهٔ جاری (دقیقه)" Binding="{Binding Display.StageEstimateText}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
