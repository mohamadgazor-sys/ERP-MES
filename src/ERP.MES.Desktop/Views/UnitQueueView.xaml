<UserControl x:Class="ERP.MES.Desktop.Views.UnitQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:UnitQueueViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:UnitQueueViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="واحد تولید:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="UnitBox" ItemsSource="{Binding Units}" DisplayMemberPath="Name" Width="220" Margin="0,0,8,0" SelectionChanged="OnUnitChanged" />
                <Button Content="بارگذاری دوباره" Padding="12,4" Click="OnReloadClick" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </WrapPanel>

            <TextBlock Text="صف" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,4" />
            <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="360" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ردیف" Binding="{Binding OrderText}" Width="50" />
                    <DataGridTextColumn Header="درخواست" Binding="{Binding RequestNo}" ElementStyle="{StaticResource LtrCell}" Width="90" />
                    <DataGridTextColumn Header="آیتم" Binding="{Binding ItemNo}" ElementStyle="{StaticResource LtrCell}" Width="80" />
                    <DataGridTemplateColumn Header="نقشه" Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="نقشه" Padding="6,1" MinWidth="48" Click="OnOpenDrawingClick" ToolTip="نقشهٔ فنی این آیتم (فایل PDF) را باز می‌کند. نقشه فقط با همین کلیک خوانده می‌شود؛ اگر نقشه‌ای بارگذاری نشده باشد پیام می‌دهد." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                    <DataGridTextColumn Header="قطعه" Binding="{Binding PartName}" Width="*" />
                    <DataGridTextColumn Header="مرحله" Binding="{Binding StageText}" Width="*" />
                    <DataGridTextColumn Header="تعداد" Binding="{Binding QuantityText}" Width="60" />
                    <DataGridTextColumn Header="اولویت" Binding="{Binding PriorityText}" Width="80" />
                    <DataGridTextColumn Header="دسته" Binding="{Binding CategoryText}" Width="110" />
                    <DataGridTextColumn Header="وضعیت مرحله" Binding="{Binding StatusText}" Width="130" />
                    <DataGridTextColumn Header="دلیل/قابلیت اجرا" Binding="{Binding ReasonText}" Width="*" />
                    <DataGridTextColumn Header="جایگاه برنامه‌ریزی" Binding="{Binding PositionText}" Width="80" />
                    <DataGridTextColumn Header="جایگزینی مدیریت" Binding="{Binding OverrideText}" Width="*" />
                    <DataGridTextColumn Header="پایان برنامه‌ریزی‌شده" Binding="{Binding PlannedEndText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Margin="0,8,0,0">
                <Button Content="بالا (برنامه‌ریزی)" Padding="10,4" Margin="0,0,6,4" Click="OnUpClick" IsEnabled="{Binding CanOrder}" />
                <Button Content="پایین (برنامه‌ریزی)" Padding="10,4" Margin="0,0,6,4" Click="OnDownClick" IsEnabled="{Binding CanOrder}" />
                <ComboBox x:Name="PriorityBox" ItemsSource="{Binding Priorities}" DisplayMemberPath="Text" SelectedIndex="2" Width="90" Margin="0,0,6,4" />
                <Button Content="تغییر اولویت" Padding="10,4" Margin="0,0,14,4" Click="OnPriorityClick" IsEnabled="{Binding CanChangePriority}" />
                <Button Content="شروع (تولید)" Padding="10,4" Margin="0,0,6,4" Click="OnStartClick" IsEnabled="{Binding CanRun}" />
                <Button Content="ارسال به کنترل کیفیت (تولید)" Padding="10,4" Margin="0,0,14,4" Click="OnSubmitClick" IsEnabled="{Binding CanRun}" />
                <Button Content="توقف…" Padding="10,4" Margin="0,0,6,4" Click="OnStopClick" IsEnabled="{Binding CanHold}" />
                <Button Content="ازسرگیری" Padding="10,4" Margin="0,0,14,4" Click="OnResumeClick" IsEnabled="{Binding CanHold}" />
                <Button Content="جایگزینی مدیریت…" Padding="10,4" Margin="0,0,6,4" Click="OnOverrideClick" IsEnabled="{Binding CanOverride}" />
                <Button Content="پاک‌کردن جایگزینی…" Padding="10,4" Margin="0,0,6,4" Click="OnClearOverrideClick" IsEnabled="{Binding CanOverride}" />
                <Button Content="تأیید بازبینی" Padding="10,4" Margin="0,0,6,4" Click="OnConfirmClick" IsEnabled="{Binding CanOverride}" />
            </WrapPanel>

            <TextBlock Text="در انتظار آزادسازی (قابل اجرا نیست)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,12,0,4" />
            <DataGrid x:Name="PendingGrid" ItemsSource="{Binding Pending}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="220" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="درخواست" Binding="{Binding RequestNo}" ElementStyle="{StaticResource LtrCell}" Width="90" />
                    <DataGridTextColumn Header="آیتم" Binding="{Binding ItemNo}" ElementStyle="{StaticResource LtrCell}" Width="80" />
                    <DataGridTemplateColumn Header="نقشه" Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="نقشه" Padding="6,1" MinWidth="48" Click="OnOpenDrawingClick" ToolTip="نقشهٔ فنی این آیتم (فایل PDF) را باز می‌کند. نقشه فقط با همین کلیک خوانده می‌شود؛ اگر نقشه‌ای بارگذاری نشده باشد پیام می‌دهد." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                    <DataGridTextColumn Header="قطعه" Binding="{Binding PartName}" Width="*" />
                    <DataGridTextColumn Header="مرحله" Binding="{Binding StageText}" Width="*" />
                    <DataGridTextColumn Header="اولویت" Binding="{Binding PriorityText}" Width="80" />
                    <DataGridTextColumn Header="وضعیت مرحله" Binding="{Binding StatusText}" Width="130" />
                    <DataGridTextColumn Header="دلیل" Binding="{Binding ReasonText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="آزادسازی مرحلهٔ اول (برنامه‌ریزی)" Padding="10,4" Click="OnReleaseClick" />
            </WrapPanel>

            <StackPanel Visibility="{Binding CanManageDesignations, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <TextBlock Text="سرپرستان واحدها (مدیر تولید)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"
                           Text="کاربران تولید را مدیر سیستم به واحد کاری‌شان اختصاص می‌دهد (صفحهٔ «کاربران و حساب‌ها»). مدیر تولید از میان آن‌ها سرپرست هر واحد را تعیین می‌کند؛ سرپرست نوبت کاری می‌دهد، گزارش‌های روزانه را بازبینی می‌کند و اضافه‌کاری پیشنهاد می‌دهد." />
                <DataGrid x:Name="DesignationGrid" ItemsSource="{Binding DesignationRows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="180" Background="{StaticResource CardBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کاربر" Binding="{Binding Row.UserDisplayName}" Width="*" />
                        <DataGridTextColumn Header="واحد" Binding="{Binding Row.UnitCode}" ElementStyle="{StaticResource LtrCell}" Width="*" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="120" />
                        <DataGridTextColumn Header="سرپرست" Binding="{Binding SupervisorText}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="تعیین به‌عنوان سرپرست" Padding="10,4" MinWidth="150" Margin="0,0,8,4" Click="OnMakeSupervisorClick"
                            ToolTip="کاربر انتخاب‌شده را سرپرست واحدش می‌کند." />
                    <Button Content="برداشتن سرپرستی" Padding="10,4" MinWidth="130" Margin="0,0,8,4" Click="OnRemoveSupervisorClick"
                            ToolTip="سرپرستی کاربر انتخاب‌شده را برمی‌دارد؛ او همچنان در واحد کار می‌کند." />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
