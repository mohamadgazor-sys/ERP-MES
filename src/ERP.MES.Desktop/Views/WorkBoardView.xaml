<UserControl x:Class="ERP.MES.Desktop.Views.WorkBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ERP.MES.Desktop.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="MessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1E6B34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static vm:WorkBoardViewModel.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="{x:Static vm:WorkBoardViewModel.Note}" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageStyle}" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="واحد تولید:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="UnitBox" ItemsSource="{Binding Units}" DisplayMemberPath="Name" Width="220" Margin="0,0,8,0" SelectionChanged="OnUnitChanged" />
                <Button Content="بارگذاری دوباره" Padding="12,4" Click="OnReloadClick" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </WrapPanel>

            <TextBlock Text="مراحل واحد (قابل‌اجرا، مسدود، در انتظار)" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="StageGrid" ItemsSource="{Binding Stages}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="300" Background="{StaticResource CardBrush}" SelectionChanged="OnStageChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="آیتم" Binding="{Binding ItemText}" Width="*" />
                    <DataGridTextColumn Header="مرحله" Binding="{Binding StageText}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="120" />
                    <DataGridTextColumn Header="چرا هنوز قابل شروع نیست / قابل اجرا" Binding="{Binding BlockText}" Width="2*" />
                    <DataGridTextColumn Header="نوبت‌های کاری" Binding="{Binding SessionsText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0">
                <Button Content="محاسبهٔ معیارهای مرحله" Padding="10,4" Margin="0,0,8,4" Click="OnMetricsClick" />
                <Button Content="ارسال مرحله به کنترل کیفیت" Padding="10,4" Margin="0,0,8,4" Click="OnSubmitStageClick" IsEnabled="{Binding IsOperator}" />
            </WrapPanel>
            <TextBlock Text="{Binding MetricsText}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

            <Border Margin="0,10,0,0" Padding="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Visibility="{Binding IsSupervisor, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="تخصیص و شروع کار (سرپرست واحد)" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="ماشین (فقط ماشین‌های همین واحد):" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="MachineBox" ItemsSource="{Binding Machines}" DisplayMemberPath="Code" Width="140" Margin="0,0,12,4" />
                        <TextBlock Text="اپراتور مجاز:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="OperatorBox" ItemsSource="{Binding Operators}" DisplayMemberPath="Name" Width="200" Margin="0,0,12,4" />
                        <TextBlock Text="دلیل کار خارج از شیفت (در صورت نیاز):" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="OutsideBox" Width="220" Margin="0,0,12,4" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="تخصیص و شروع" Padding="12,5" Margin="0,0,8,4" Click="OnDispatchStartClick" IsEnabled="{Binding CanDispatchSelected}" />
                        <Button Content="فقط تخصیص" Padding="12,5" Margin="0,0,8,4" Click="OnDispatchOnlyClick" IsEnabled="{Binding CanDispatchSelected}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="نوبت‌های کاری مرحلهٔ انتخاب‌شده (بازه‌های فعال، توقف‌ها و تاریخچه)" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="SessionGrid" ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="300" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding IdText}" Width="60" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="130" />
                    <DataGridTextColumn Header="ماشین" Binding="{Binding MachineText}" Width="80" />
                    <DataGridTextColumn Header="اپراتور" Binding="{Binding OperatorText}" Width="*" />
                    <DataGridTextColumn Header="شروع" Binding="{Binding StartedText}" Width="130" />
                    <DataGridTextColumn Header="زمان کار (ساعت:دقیقه)" Binding="{Binding ActiveText}" Width="90" />
                    <DataGridTextColumn Header="زمان توقف" Binding="{Binding PausedText}" Width="80" />
                    <DataGridTextColumn Header="هشدار/یادداشت" Binding="{Binding FlagsText}" Width="*" />
                    <DataGridTextColumn Header="تأیید زمان" Binding="{Binding ApprovalText}" Width="120" />
                    <DataGridTextColumn Header="تاریخچهٔ توقف‌ها" Binding="{Binding PauseHistoryText}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="دلیل توقف:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ReasonBox" ItemsSource="{Binding Reasons}" DisplayMemberPath="Value.Name" Width="260" Margin="0,0,12,4" />
                <Button Content="شروع" Padding="10,4" Margin="0,0,6,4" Click="OnStartClick" IsEnabled="{Binding IsSupervisor}" />
                <Button Content="توقف…" Padding="10,4" Margin="0,0,6,4" Click="OnPauseClick" />
                <Button Content="ازسرگیری" Padding="10,4" Margin="0,0,6,4" Click="OnResumeClick" />
                <Button Content="پایان نوبت…" Padding="10,4" Margin="0,0,6,4" Click="OnFinishClick" />
                <Button Content="تحویل به اپراتور انتخابی (بالا)" Padding="10,4" Margin="0,0,6,4" Click="OnHandOverClick" IsEnabled="{Binding IsSupervisor}" />
                <Button Content="لغو نوبت شروع‌نشده…" Padding="10,4" Margin="0,0,6,4" Click="OnCancelClick" IsEnabled="{Binding IsSupervisor}" />
            </WrapPanel>

            <Border Margin="0,10,0,0" Padding="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Visibility="{Binding IsSupervisor, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="قطعی مشترک (قطع برق و مانند آن): یک رویداد، چند نوبت؛ زمان‌ها برای هر نوبت جدا ثبت می‌شود" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="ثبت قطعی برای همهٔ نوبت‌های فعال واحد (با دلیل انتخاب‌شده)…" Padding="10,4" Margin="0,0,8,4" Click="OnOutageClick" />
                    </WrapPanel>
                    <DataGrid x:Name="OutageGrid" ItemsSource="{Binding Outages}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="120" Background="{StaticResource CardBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شمارهٔ قطعی" Binding="{Binding Id}" Width="90" />
                            <DataGridTextColumn Header="توضیح" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="پایان قطعی انتخاب‌شده و ازسرگیری نوبت‌ها" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnEndOutageClick" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Padding="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Visibility="{Binding CanCorrect, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="برنامه‌ریزی: تأیید و اصلاح زمان واقعی نوبت" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="فقط زمان تأییدشده در هزینه و شاخص‌ها می‌آید. اصلاح نیازمند دلیل است، مقدار قبلی را نگه می‌دارد و تأیید را برمی‌دارد؛ پس از ارسال مرحله به کنترل کیفیت مجاز نیست." />
                    <WrapPanel Margin="0,6,0,0">
                        <ComboBox x:Name="BoundaryBox" Width="170" Margin="0,0,8,4" SelectedIndex="0">
                            <ComboBoxItem Content="شروع نوبت" Tag="Start" />
                            <ComboBoxItem Content="آغاز توقف" Tag="PauseStart" />
                            <ComboBoxItem Content="پایان توقف" Tag="PauseEnd" />
                            <ComboBoxItem Content="پایان نوبت" Tag="Finish" />
                        </ComboBox>
                        <TextBlock Text="شمارهٔ توقف:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PauseIndexBox" Width="40" Text="1" Margin="0,0,8,4" FlowDirection="LeftToRight" />
                        <TextBlock Text="زمان جدید (تاریخ شمسی و ساعت ۲۴ساعته):" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="InstantBox" Width="160" Margin="0,0,8,4" FlowDirection="LeftToRight" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="اصلاح زمان…" Padding="10,4" Margin="0,0,8,4" Click="OnCorrectClick" />
                        <Button Content="تأیید زمان واقعی نوبت پایان‌یافته" Padding="10,4" Margin="0,0,8,4" Click="OnApproveClick" IsEnabled="{Binding CanApprove}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="نوبت‌های من (اپراتور)" Style="{StaticResource SectionStyle}" />
            <DataGrid x:Name="MineGrid" ItemsSource="{Binding Mine}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="200" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding IdText}" Width="60" />
                    <DataGridTextColumn Header="مرحله" Binding="{Binding StageText}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="130" />
                    <DataGridTextColumn Header="ماشین" Binding="{Binding MachineText}" Width="80" />
                    <DataGridTextColumn Header="زمان کار" Binding="{Binding ActiveText}" Width="80" />
                    <DataGridTextColumn Header="زمان توقف" Binding="{Binding PausedText}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="دکمه‌های «توقف»، «ازسرگیری» و «پایان نوبت» بالا روی ردیف انتخاب‌شده در همان فهرست (نوبت‌های مرحله) یا در این فهرست (نوبت‌های من) کار می‌کنند؛ اپراتور فقط روی نوبت خودش اجازه دارد." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
