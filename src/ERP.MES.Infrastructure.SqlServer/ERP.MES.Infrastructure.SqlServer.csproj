<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SQL Server provider wiring (Decision Log #117). Deliberately NOT part of ERP-MES.sln: the main Windows job and every developer machine restore and build without this package until the
       owner approves it for production; the `sqlserver` job of the CI workflow restores, scans and tests this project on its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design-time only (the SQL Server migrations will live in this project); PrivateAssets keeps it out of everything that references this project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERP.MES.Infrastructure\ERP.MES.Infrastructure.csproj" />
  </ItemGroup>

</Project>
